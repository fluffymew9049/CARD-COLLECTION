<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bear's Vault</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome for TCG and Hobby icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            color: #f3f4f6;
            -webkit-tap-highlight-color: transparent;
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 9999px;
        }
        /* Drawer animation */
        .drawer-slide-up {
            transform: translateY(100%);
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .drawer-slide-up.active {
            transform: translateY(0);
        }
        /* Scanner scanning light bar */
        @keyframes laser-scan {
            0% { top: 0%; }
            50% { top: 100%; }
            100% { top: 0%; }
        }
        .scanner-laser {
            animation: laser-scan 3s infinite linear;
        }
        /* Subtle glowing border for cards with prices loaded */
        .premium-border-glow {
            box-shadow: 0 0 12px rgba(245, 158, 11, 0.15);
        }
    </style>
</head>
<body class="min-h-screen pb-32">

    <div class="max-w-md mx-auto px-4 pt-6">
        
        <!-- Header Section -->
        <header class="flex justify-between items-center mb-5">
            <div>
                <h1 class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-500 to-yellow-300 tracking-tight">BEAR's Treasures!!</h1>
                <p class="text-xs text-slate-400 mt-0.5">Built by FLUFFY with LOVE!!!!</p>
            </div>
            
            <div class="flex gap-2">
                <!-- Image helper guide button -->
                <button onclick="toggleImageHelp()" class="p-2.5 bg-slate-900 border border-slate-800 rounded-xl hover:bg-slate-800 transition text-emerald-400" title="How to upload images">
                    <i class="fa-regular fa-image text-lg"></i>
                </button>
                <!-- Database configuration button -->
                <button onclick="toggleDbModal()" class="p-2.5 bg-slate-900 border border-slate-800 rounded-xl hover:bg-slate-800 transition text-amber-400" title="Database Sync Settings">
                    <i class="fa-solid fa-database text-lg"></i>
                </button>
            </div>
        </header>

        <!-- Dynamic Counter Row -->
        <section class="grid grid-cols-2 gap-3 mb-4">
            <div class="bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800/80 p-3 rounded-2xl text-center shadow-lg">
                <span class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Total Items</span>
                <p id="stat-total-cards" class="text-xl font-bold text-slate-100 mt-1">0</p>
            </div>
            <div class="bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800/80 p-3 rounded-2xl text-center shadow-lg">
                <span class="text-[10px] uppercase tracking-wider font-semibold text-slate-400">Unique Items</span>
                <p id="stat-unique-cards" class="text-xl font-bold text-slate-100 mt-1">0</p>
            </div>
        </section>

        <!-- Portfolio Valuation Dashboard -->
        <section class="bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 border border-amber-500/20 p-4 rounded-2xl shadow-xl mb-6 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-amber-500/5 rounded-full blur-2xl"></div>
            
            <div class="flex justify-between items-center mb-3">
                <span class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
                    <i class="fa-solid fa-wallet"></i> PORTFOLIO ESTIMATIONS
                </span>
                <span class="text-[9px] bg-amber-500/10 text-amber-300 border border-amber-500/20 px-2 py-0.5 rounded-full font-mono uppercase">Sheet Value</span>
            </div>

            <!-- Double Estimation Box -->
            <div class="grid grid-cols-2 gap-3.5 border-b border-slate-800/60 pb-3">
                <div>
                    <span class="text-[10px] text-slate-400 font-semibold block">Lowest Portfolio Value</span>
                    <p id="stat-lowest-val" class="text-lg font-black text-emerald-400 mt-1">$0.00</p>
                </div>
                <div class="border-l border-slate-800/60 pl-3.5">
                    <span class="text-[10px] text-slate-400 font-semibold block">Highest Portfolio Value</span>
                    <p id="stat-highest-val" class="text-lg font-black text-amber-400 mt-1">$0.00</p>
                </div>
            </div>

            <div class="pt-2.5 flex justify-between items-center text-xs">
                <span class="text-slate-400">Calculated Mid-Point Estimate:</span>
                <span id="stat-avg-val" class="font-extrabold text-slate-100">$0.00</span>
            </div>
        </section>

        <!-- Search and Filters Section -->
        <section class="space-y-3 mb-6">
            <!-- Search field -->
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                <input id="search-input" type="text" oninput="applyFilters()" placeholder="Search names, codes, categories..." class="w-full bg-slate-900/90 border border-slate-800/80 rounded-xl [...]
            </div>

            <!-- Game/Universe Filters row (Dynamically loaded from spreadsheet columns) -->
            <div class="flex gap-2 overflow-x-auto pb-1" id="game-filter-container">
                <button onclick="setGameFilter('ALL')" id="filter-game-ALL" class="flex-shrink-0 px-4 py-2 bg-amber-500 text-slate-950 font-bold rounded-lg text-xs tracking-wider transition upper[...]
            </div>
        </section>

        <!-- main display container -->
        <main>
            <div id="sync-warning" class="hidden bg-slate-900/95 border border-amber-500/30 p-4 rounded-xl mb-4 text-sm shadow-md">
                <div class="flex gap-2.5 items-start">
                    <i class="fa-solid fa-triangle-exclamation text-amber-400 mt-0.5"></i>
                    <div>
                        <p class="font-bold text-amber-300">Sync Warning / Access Check</p>
                        <p class="text-xs text-slate-300 mt-1 leading-relaxed">
                            No active database rows could be parsed. Check that your Google Sheet has sharing settings set to 
                            <strong class="text-white">"Anyone with the link can view"</strong>.
                        </p>
                        <button onclick="toggleDbModal()" class="text-[11px] font-semibold text-amber-400 underline mt-2 block">Configure Sheet Link</button>
                    </div>
                </div>
            </div>

            <!-- Card grid output -->
            <div id="card-grid" class="grid grid-cols-2 gap-3.5">
                <!-- Card components dynamically injected here -->
            </div>

            <!-- Loading Spinner State -->
            <div id="loader-view" class="flex flex-col items-center justify-center py-16 space-y-3">
                <div class="w-8 h-8 border-4 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
                <p class="text-xs text-slate-400">Streaming collection data from spreadsheet...</p>
            </div>
        </main>

    </div>

    <!-- Dual Scanning & Manual Floating Action Bottom Bar -->
    <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-30 max-w-md w-full px-4 flex gap-3 justify-center">
        <!-- Scan Card Button -->
        <button onclick="openCameraScanner()" class="flex-1 flex items-center justify-center gap-2 px-4 py-4 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400[...]
            <i class="fa-solid fa-camera text-sm animate-pulse"></i>
            Scan Item
        </button>
        <!-- Manual Add Button -->
        <button onclick="openManualAdd()" class="flex-1 flex items-center justify-center gap-2 px-4 py-4 bg-slate-900 border border-slate-800 hover:bg-slate-800 text-amber-400 font-extrabold text[...]
            <i class="fa-solid fa-pen-to-square text-sm"></i>
            Add Manually
        </button>
    </div>

    <!-- Custom Dialog / Toast Container -->
    <div id="custom-toast" class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] max-w-sm w-full px-4 transition-all duration-300 transform -translate-y-24 opacity-0 pointer-events-none">
        <div id="toast-bg" class="bg-slate-900 border p-4 rounded-xl shadow-2xl flex gap-3 items-center">
            <i id="toast-icon" class="fa-solid text-lg"></i>
            <div class="flex-1">
                <p id="toast-title" class="text-xs font-bold text-slate-100"></p>
                <p id="toast-msg" class="text-[11px] text-slate-400 mt-0.5"></p>
            </div>
        </div>
    </div>

    <!-- Video Camera Scanner Modal Overlay -->
    <div id="scanner-modal" class="fixed inset-0 bg-black z-50 flex flex-col justify-between hidden">
        <!-- Scanner HUD Header -->
        <div class="p-4 bg-gradient-to-b from-black/80 to-transparent flex justify-between items-center z-10">
            <div>
                <h3 class="font-bold text-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-qrcode text-amber-400"></i>
                    AI Item Scanner
                </h3>
                <p class="text-[10px] text-slate-400">Position the item/card or upload a file</p>
            </div>
            <button onclick="closeCameraScanner()" class="p-2.5 bg-slate-900/80 border border-slate-800 rounded-xl text-slate-300 hover:text-white">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <!-- Viewfinder Canvas / Camera frame container -->
        <div class="relative flex-1 overflow-hidden flex items-center justify-center bg-slate-950">
            <!-- Cam Video stream -->
            <video id="scanner-video" autoplay playsinline class="w-full h-full object-cover"></video>
            
            <!-- Hidden Capture Canvas -->
            <canvas id="scanner-canvas" class="hidden"></canvas>

            <!-- Holographic Overlay Targeting Reticle -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none p-8">
                <div class="w-72 aspect-[3/4] border-2 border-dashed border-amber-400/40 rounded-2xl relative shadow-[0_0_50px_rgba(0,0,0,0.8)]">
                    <!-- Corner frames decorative -->
                    <div class="absolute -top-1.5 -left-1.5 w-6 h-6 border-t-4 border-l-4 border-amber-400 rounded-tl-lg"></div>
                    <div class="absolute -top-1.5 -right-1.5 w-6 h-6 border-t-4 border-r-4 border-amber-400 rounded-tr-lg"></div>
                    <div class="absolute -bottom-1.5 -left-1.5 w-6 h-6 border-b-4 border-l-4 border-amber-400 rounded-bl-lg"></div>
                    <div class="absolute -bottom-1.5 -right-1.5 w-6 h-6 border-b-4 border-r-4 border-amber-400 rounded-br-lg"></div>
                    
                    <!-- Scanner scrolling laser beam -->
                    <div class="absolute left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-amber-400 to-transparent shadow-[0_0_10px_rgba(245,158,11,0.8)] scanner-laser"></div>
                </div>
            </div>

            <!-- Freeze Frame Static Capture Preview Overlay -->
            <div id="captured-preview-container" class="absolute inset-0 bg-slate-950 hidden flex-col items-center justify-center">
                <img id="captured-preview-img" class="max-h-[70vh] object-contain rounded-xl border border-slate-800 shadow-2xl">
            </div>

            <!-- Loader Overlays for processing states -->
            <div id="scanner-analysis-loader" class="absolute inset-0 bg-slate-950/90 backdrop-blur-sm hidden flex-col items-center justify-center p-6 text-center">
                <div class="w-12 h-12 border-4 border-amber-500 border-t-transparent rounded-full animate-spin mb-4"></div>
                <h4 class="font-bold text-slate-100 text-sm">Gemini Recognition Engine</h4>
                <p class="text-xs text-slate-400 max-w-xs mt-1.5 leading-relaxed">Extracting item metrics, scale, series information, and estimated market values...</p>
            </div>
        </div>

        <!-- Scanner Footer Operations -->
        <div class="p-6 bg-gradient-to-t from-black to-slate-950 border-t border-slate-900/60 flex flex-col gap-4 z-10">
            <!-- File Upload & Backup Options -->
            <div class="flex justify-between items-center gap-2">
                <!-- File upload button (Crucial bypass for sandbox/webcam issues) -->
                <label class="flex-1 py-3 px-4 bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 rounded-xl text-xs font-semibold text-center cursor-pointer flex items-center[...]
                    <i class="fa-solid fa-file-image text-amber-400 text-base"></i>
                    Upload Photo
                    <input type="file" id="file-uploader" accept="image/*" onchange="handleFileSelected(event)" class="hidden">
                </label>
                <button onclick="flipCamera()" class="py-3 px-4 bg-slate-900 border border-slate-800 rounded-xl hover:bg-slate-800 text-slate-200 text-xs font-semibold flex items-center justify-c[...]
                    <i class="fa-solid fa-arrows-rotate text-emerald-400"></i>
                    Flip Camera
                </button>
            </div>

            <!-- Capture Button container -->
            <div id="scanner-action-row" class="flex justify-center items-center gap-6">
                <!-- Demo test button for instant evaluation without physical cards -->
                <button onclick="triggerDemoMockScan()" class="text-[10px] text-amber-400 hover:underline font-bold">
                    [Run Demo Scan]
                </button>
                <button onclick="captureFrame()" class="w-16 h-16 bg-slate-100 hover:bg-white active:bg-slate-200 rounded-full border-4 border-slate-800 shadow-2xl flex items-center justify-cente[...]
                    <i class="fa-solid fa-camera text-slate-950 text-xl"></i>
                </button>
                <span class="text-[10px] text-slate-500 w-16"></span> <!-- Spacer -->
            </div>
        </div>
    </div>

    <!-- Scanning Saved / Confirmation sliding overlay dialog -->
    <div id="scanner-confirm-modal" class="fixed inset-0 bg-black/90 backdrop-blur-sm z-[60] flex items-end justify-center p-4 hidden">
        <div class="bg-slate-950 border border-slate-800 rounded-t-3xl w-full max-w-sm overflow-hidden shadow-2xl drawer-slide-up transform translate-y-0 active:translate-y-0 p-5">
            <div class="flex justify-between items-center border-b border-slate-900 pb-3 mb-4">
                <h4 id="confirm-modal-title" class="font-bold text-slate-100 flex items-center gap-1.5">
                    <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i> Confirm Scan Results
                </h4>
                <button onclick="cancelScanConfirmation()" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form id="scan-confirm-form" onsubmit="executeSaveScannedCard(event)" class="space-y-3 text-xs">
                <!-- Game Selection / Custom Category -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Category / Universe</label>
                        <select id="scan-input-game" onchange="handleCategorySelectionChange()" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 font-semibold fo[...]
                            <option value="Pokémon">POKÉMON</option>
                            <option value="Naruto">NARUTO</option>
                            <option value="Figures">FIGURES</option>
                            <option value="Gundam">GUNDAM</option>
                            <option value="CUSTOM">ADD CUSTOM CATEGORY...</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Set, Code or Scale</label>
                        <input id="scan-input-code" type="text" required class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 font-mono focus:ring-1 focus:ring-amber[...]
                    </div>
                </div>

                <!-- Custom Category Input (Revealed only when CUSTOM selected) -->
                <div id="scan-input-custom-game-container" class="hidden">
                    <label class="text-[10px] uppercase font-bold text-orange-400 block mb-1">Custom Category Name</label>
                    <input id="scan-input-custom-game" type="text" class="w-full bg-slate-900 border border-orange-500/50 rounded-lg p-2.5 text-slate-100 focus:ring-1 focus:ring-orange-500 focus:[...]
                </div>

                <!-- Card Name and Rarity -->
                <div class="grid grid-cols-3 gap-2">
                    <div class="col-span-2">
                        <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Item / Character Name</label>
                        <input id="scan-input-name" type="text" required class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 font-semibold focus:ring-1 focus:ring-a[...]
                    </div>
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Rarity / Grade</label>
                        <input id="scan-input-rarity" type="text" required class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 font-bold text-amber-400 focus:ring-1[...]
                    </div>
                </div>

                <!-- Valuation Inputs -->
                <div class="grid grid-cols-3 gap-2 border-t border-slate-900 pt-3">
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Quantity</label>
                        <input id="scan-input-qty" type="number" required min="1" value="1" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 text-center font-bol[...]
                    </div>
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Lowest Price</label>
                        <input id="scan-input-lowest" type="text" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 font-semibold placeholder-slate-600 focus:ring[...]
                    </div>
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Highest Price</label>
                        <input id="scan-input-highest" type="text" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 font-semibold placeholder-slate-600 focus:rin[...]
                    </div>
                </div>

                <!-- Custom Remarks, Source, Image Link -->
                <div class="space-y-2 border-t border-slate-900 pt-3">
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Acquisition Source</label>
                            <input id="scan-input-source" type="text" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 focus:ring-1 focus:ring-amber-500 focus:ou[...]
                        </div>
                        <div>
                            <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Date Logged</label>
                            <input id="scan-input-date" type="date" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 font-mono focus:ring-1 focus:ring-amber-500 [...]
                        </div>
                    </div>
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Image Link (Optional URL)</label>
                        <input id="scan-input-image" type="text" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 font-mono truncate focus:ring-1 focus:ring-ambe[...]
                    </div>
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-500 block mb-1">Remarks & Condition Notes</label>
                        <textarea id="scan-input-remark" rows="2" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-slate-100 focus:ring-1 focus:ring-amber-500 focus:outlin[...]
                    </div>
                </div>

                <!-- Action Triggers -->
                <div class="flex gap-2.5 pt-3 border-t border-slate-900">
                    <button type="button" onclick="cancelScanConfirmation()" class="w-1/3 py-3 bg-slate-900 hover:bg-slate-800 text-slate-300 font-semibold rounded-xl">CANCEL</button>
                    <button type="submit" id="scan-save-btn" class="flex-1 py-3 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-extrabol[...]
                        SAVE TO SHEET
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Image Help Modal -->
    <div id="image-help-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-950 border border-slate-800 rounded-2xl w-full max-w-sm overflow-hidden shadow-2xl">
            <div class="p-5 border-b border-slate-900 flex justify-between items-center">
                <h3 class="font-bold text-slate-100 flex items-center gap-2">
                    <i class="fa-regular fa-image text-emerald-400"></i>
                    Adding Pictures
                </h3>
                <button onclick="toggleImageHelp()" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-5 space-y-4 text-xs leading-relaxed max-h-[70vh] overflow-y-auto">
                <div>
                    <p class="font-bold text-slate-200 mb-1">1. Create your image column</p>
                    <p class="text-slate-400">Ensure your spreadsheet header has a column named exactly <strong class="text-emerald-400">IMAGE</strong> in all caps.</p>
                </div>
                <div>
                    <p class="font-bold text-slate-200 mb-1">2. Paste Direct Links</p>
                    <p class="text-slate-400">Paste direct image links that end with extensions like <code class="bg-slate-900 px-1 py-0.5 rounded text-amber-300">.jpg</code>, <code class="bg-sla[...]
                </div>
                <div>
                    <p class="font-bold text-slate-200 mb-1">3. Hosting Photos (Free)</p>
                    <p class="text-slate-400">If you photograph your own items or boxes, upload them to free direct hosting platforms such as <a href="https://postimages.org" target="_blank" clas[...]
                </div>
                <div class="bg-emerald-950/40 border border-emerald-900/50 p-3 rounded-xl text-emerald-300">
                    <p class="font-semibold flex items-center gap-1.5 mb-1">
                        <i class="fa-solid fa-circle-check"></i> Live Updates
                    </p>
                    Once uploaded, simply click Sync Database inside the app, and your visual binder will automatically update with item artwork.
                </div>
            </div>
        </div>
    </div>

    <!-- Connection Dialog Modal -->
    <div id="db-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-950 border border-slate-800 rounded-2xl w-full max-w-sm overflow-hidden shadow-2xl">
            <div class="p-5 border-b border-slate-900 flex justify-between items-center">
                <h3 class="font-bold text-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-database text-amber-400"></i>
                    Database Connections
                </h3>
                <button onclick="toggleDbModal()" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
                <!-- READ SETTINGS -->
                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-amber-400 uppercase tracking-wide flex items-center gap-1.5">
                        <i class="fa-solid fa-cloud-arrow-down"></i> 1. Read Connection
                    </label>
                    <span class="text-[10px] text-slate-400 block mb-1">Google Sheets Edit Link</span>
                    <input id="sheet-url-input" type="text" placeholder="https://docs.google.com/spreadsheets/d/..." class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-xs te[...]
                </div>

                <!-- WRITE SETTINGS -->
                <div class="space-y-1.5 border-t border-slate-900 pt-3">
                    <label class="text-xs font-bold text-orange-400 uppercase tracking-wide flex items-center gap-1.5">
                        <i class="fa-solid fa-cloud-arrow-up"></i> 2. Write Connection (Apps Script)
                    </label>
                    <span class="text-[10px] text-slate-400 block mb-1">Google Apps Script Web App URL (For Scanning Save)</span>
                    <input id="script-url-input" type="text" placeholder="https://script.google.com/macros/s/.../exec" class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-xs [...]
                </div>

                <!-- GEMINI API SETTINGS -->
                <div class="space-y-1.5 border-t border-slate-900 pt-3">
                    <label class="text-xs font-bold text-teal-400 uppercase tracking-wide flex items-center gap-1.5">
                        <i class="fa-solid fa-key"></i> 3. Gemini API Key (Required for Scanner & Prices)
                    </label>
                    <span class="text-[10px] text-slate-400 block mb-1">Get a free key from <a href="https://aistudio.google.com/" target="_blank" class="text-teal-400 underline font-semibold">Go[...]
                    <input id="gemini-key-input" type="password" placeholder="AIzaSy..." class="w-full bg-slate-900 border border-slate-800 rounded-lg p-2.5 text-xs text-slate-100 focus:outline-n[...]
                    <p class="text-[9px] text-slate-500 leading-normal">Note: If running inside the Chat Canvas preview, this can be left blank. GitHub Pages deployment requires saving your own k[...]
                </div>

                <!-- HELP BLOCK -->
                <div class="bg-slate-900/60 p-3 rounded-xl text-[10px] text-slate-400 space-y-2 leading-relaxed">
                    <p class="font-bold text-slate-200 uppercase tracking-wider flex items-center gap-1">
                        <i class="fa-solid fa-circle-question text-amber-400"></i> Setup Quick Guide:
                    </p>
                    <ol class="list-decimal list-inside space-y-1 text-slate-300">
                        <li>Ensure Google Sheet is set to <strong class="text-white">"Anyone with the link can view"</strong>.</li>
                        <li>In Google Sheets, open <strong class="text-white">Extensions > Apps Script</strong>, paste your deployment code, and save.</li>
                    </ol>
                </div>

                <div class="flex gap-2 pt-2">
                    <button onclick="saveDbSettings()" class="w-full py-2.5 bg-amber-500 text-slate-950 font-bold rounded-lg text-xs tracking-wider transition hover:bg-amber-400 uppercase">Save &[...]
                </div>
                
                <!-- Connection logs for diagnostics/debugging -->
                <div class="border-t border-slate-900 pt-3">
                    <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Sync Diagnostics</p>
                    <div id="diagnostic-log" class="bg-slate-950 border border-slate-900 rounded-lg p-2.5 h-24 overflow-y-auto text-[9px] font-mono text-slate-400 leading-normal space-y-0.5">
                        <!-- Diagnostic console logs output here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Rest of file continues... (backup copy) -->

</body>
